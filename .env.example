# Variables de entorno que los JSON LIMPIOS referencian como {{ $env.NOMBRE }}.
# Aquí SOLO van los NOMBRES, nunca valores reales.
#
# IMPORTANTE: estos valores NO se ponen aquí ni en el repo. Se configuran en la
# instancia de n8n (Hetzner) para que el flujo importado funcione. Eso es el
# paso 2-B (deploy), no este repo.

# Token del Agent Bot de Chatwoot (header api_access_token de los nodos HTTP).
# Esta es la env var que los flujos LIMPIOS resuelven en runtime: hay que ponerla
# en la INSTANCIA de n8n (Hetzner), no aquí. Ver docs/deploy-2b.md.
CHATWOOT_API_TOKEN=

# --- Deploy GitHub -> n8n (scripts/deploy.mjs, paso 2-B) ---
# Estas dos son para el SCRIPT de deploy (en tu máquina o CI), no para los flujos.
# URL base de la instancia de n8n (sin barra final).
N8N_BASE_URL=
# API key de n8n: Settings -> n8n API -> Create an API key. Va en X-N8N-API-KEY.
N8N_API_KEY=

# --- Migraciones de schema (scripts/migrate.mjs) ---
# Conexión a la DB destino. Empieza SIEMPRE por mims_dev, nunca prod sin probar.
# Formato libpq; añade usuario:contraseña@ antes del host si tu Postgres pide login.
DATABASE_URL=postgresql://localhost:5432/mims_dev
